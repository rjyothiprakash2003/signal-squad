# Signal Squad configuration.
# Copy to .env if you want to override defaults. Do not put real secrets here.
# This game does not use API keys or a database.

PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Set to 1 when the process sits behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0

# Room lifetime and reconnect policy, in milliseconds.
ROOM_TTL_MS=10800000
HOST_GRACE_MS=45000
DISCONNECT_REMOVE_MS=600000
EMPTY_ROOM_MS=900000

# Optional round clocks, in milliseconds. Defaults: easy 180000, medium 240000, hard 300000.
# ROUND_MS_EASY=180000
# ROUND_MS_MEDIUM=240000
# ROUND_MS_HARD=300000

# Wrong-answer clock penalty, in milliseconds. Default 15000.
# PENALTY_MS=15000
